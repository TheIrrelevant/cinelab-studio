{
  "name": "cinelab-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm human:build && pnpm --filter @cinelab/web dev",
    "build": "pnpm human:build && pnpm --filter @cinelab/web build",
    "start": "pnpm --filter @cinelab/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:structure": "node tools/check-structure.mjs",
    "human:build": "node packages/human/scripts/build-assets.ts apps/web/public/human",
    "check": "pnpm check:structure && pnpm lint && pnpm typecheck && pnpm test",
    "test:studio:browser": "pnpm --filter @cinelab/web test:studio:browser",
    "test:e2e": "pnpm --filter @cinelab/web test:e2e",
    "test:human:browser": "pnpm --filter @cinelab/web test:human:browser"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "next": "16.2.10",
    "playwright": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
